ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6
LOOM_KNOWLEDGE_ROOT=/Users/yourname/Desktop/Knowledge system
CODEX_BIN=/opt/homebrew/bin/codex
LOOM_AI_CLI_DEFAULT=codex

# Optional owner-only cloud sync (Backend Phase 1). Leave BOTH unset to keep
# LOOM 100% local — the backend layer stays inert without these. See
# docs/supabase-setup.md. The anon key is public by design; Row-Level Security
# is the real protection. Inlined at build time, so set on BOTH the web build
# (Vercel env) and the static-export build (macOS app shell env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
