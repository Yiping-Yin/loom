{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.mdx",
    "**/*.ts",
    "**/*.tsx",
    ".next-app-dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-diag/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts",
    ".next-app-dev/dev/types/**/*.ts",
    ".next-dev24/types/**/*.ts",
    ".next-dev24/dev/types/**/*.ts"
  ],
  "exclude": [
    ".app-store",
    "archive",
    "node_modules"
  ]
}
