{
  "name": "loom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs -p 3000 -H 0.0.0.0",
    "dev:raw": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "llm:smoke": "tsx scripts/llm-smoke.ts",
    "test:contracts": "tsx --test tests/*.test.*",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm run smoke",
    "verify:new-loom-audit": "node scripts/verify-new-loom-completion-audit.mjs",
    "verify:approval-gates-ready": "node scripts/verify-approval-gates-ready.mjs",
    "verify:product": "npm run verify:new-loom-audit && npm run verify:approval-gates-ready && npm run typecheck && npm run test:contracts && npm run smoke && git diff --check && npm run app:check-project && npm run app:user && npm run app:smoke",
    "verify:real-files-importer": "node scripts/verify-real-file-importer.mjs",
    "verify:native-sidecar": "node scripts/verify-native-sidecar.mjs",
    "status:buckets": "node scripts/status-buckets.mjs",
    "stage:bucket": "node scripts/stage-bucket.mjs",
    "research": "tsx scripts/research.ts",
    "ingest": "tsx scripts/ingest-knowledge.ts",
    "atlas": "tsx scripts/build-atlas.ts",
    "rag": "tsx scripts/build-rag-index.ts",
    "search": "tsx scripts/build-search-index.ts",
    "knowledge:prune": "node scripts/prune-generated-public.mjs",
    "knowledge:refresh": "npm run ingest && npm run search && npm run rag && npm run knowledge:prune",
    "clean:workspace:dry": "node scripts/clean-workspace-generated.mjs",
    "clean:workspace": "node scripts/clean-workspace-generated.mjs --apply",
    "clean:native-temp:dry": "node scripts/clean-loom-native-temp.mjs",
    "clean:native-temp": "node scripts/clean-loom-native-temp.mjs --apply",
    "batch": "tsx scripts/batch-process.ts",
    "index": "node scripts/pagefind-if-html.mjs .next/server/app public/pagefind",
    "icons": "node scripts/generate-icons.mjs",
    "app": "node scripts/build-install-loom-app.mjs auto",
    "app:user": "node scripts/build-install-loom-app.mjs user",
    "app:system": "node scripts/build-install-loom-app.mjs system",
    "app:clean": "node scripts/clean-loom-app-bundles.mjs",
    "app:package": "node scripts/package-loom-app.mjs",
    "app:archive": "npm run build && node scripts/build-static-export.mjs && node scripts/archive-loom-app.mjs",
    "app:archive:store": "npm run build && node scripts/build-static-export.mjs && node scripts/archive-loom-app.mjs --store",
    "app:export:store": "node scripts/export-loom-app-store.mjs",
    "app:check-project": "node scripts/check-loom-macos-project-files.mjs",
    "app:smoke": "node scripts/installed-app-smoke.mjs",
    "app:screenshots": "node scripts/app-store-screenshots.mjs",
    "app:preflight": "node scripts/app-store-preflight.mjs",
    "app:where": "node scripts/where-loom-app.mjs",
    "app:open": "if [ -d \"$HOME/Applications/Loom.app\" ]; then open \"$HOME/Applications/Loom.app\"; else open /Applications/Loom.app; fi",
    "typecheck:fast": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@huggingface/transformers": "^4.0.1",
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^16.2.9",
    "@supabase/supabase-js": "^2.108.2",
    "@swc/helpers": "0.5.15",
    "dompurify": "^3.4.10",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.11",
    "lucide-react": "^1.20.0",
    "marked": "^18.0.0",
    "marked-katex-extension": "^5.1.8",
    "mermaid": "^11.4.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.9",
    "pdfjs-dist": "^5.6.205",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.13.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "array.prototype.findlast": "^1.2.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "pagefind": "^1.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.1",
    "tsx": "4.19.1",
    "typescript": "^6.0.3",
    "umap-js": "^1.4.0"
  }
}
